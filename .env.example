# Application
APP_NAME=ai-bi-backend
ENV=development
LOG_LEVEL=INFO

# Security
API_KEY=change-me

# Database
# Connect as a READ-ONLY role (see example/readonly_role.sql). Outside
# ENV=development the API refuses to start if this role is a superuser or
# can create roles/databases.
#   docker compose (API in container): ...@postgres:5432/ai_bi_db
#   API on host, compose Postgres:     ...@localhost:5433/ai_bi_db
DATABASE_URL=postgresql+psycopg2://ai_bi_readonly:readonly_pwd@localhost:5433/ai_bi_db
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=your-key-here


