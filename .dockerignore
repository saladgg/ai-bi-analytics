*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
*.db

# VCS, IDE, tooling
.git/
.github/
.idea/
.vscode/
.qodo/
todos.md

