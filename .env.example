# Application
APP_NAME=ai-bi-backend
# development | staging | production. Anything but development enforces the
# startup safety checks (read-only DB role, query allowlist, strong keys, LLM key).
ENV=development

# Logging: LOG_FORMAT defaults to json outside development, text in it.
# Questions are logged as a hash + length unless LOG_QUESTIONS=true.
LOG_LEVEL=INFO
# LOG_FORMAT=json
LOG_QUESTIONS=false

# OpenTelemetry traces + metrics over OTLP (standard OTEL_* variables).
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf   # or grpc (port 4317)
# OTEL_SERVICE_NAME=ai-bi-backend

# Security
# One entry per client: client_id:sha256(key). The server stores only
# hashes. Generate a key and its entry with:
#   make api-key CLIENT=<client_id>
# Rotate by adding the new entry next to the old one, then removing the old.
API_KEYS=
# Legacy single key (authenticates as client "default"). Outside
# ENV=development it must be 32+ characters and not a placeholder.
API_KEY=change-me

# Rate limiting (per client, sliding window)
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
# If Redis is unreachable: false = reject with 503 (keeps LLM spend bounded),
# true = serve requests unthrottled.
RATE_LIMIT_FAIL_OPEN=false
# Behind a reverse proxy, list the proxy's IPs here so uvicorn takes the
# client address from X-Forwarded-For. Only trusted proxies may set it;
# the rate limiter never reads the header itself.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Redis (rate limiting + response cache). The compose Redis requires a
# password (REDIS_PASSWORD, default redis_dev_pwd); this URL is for running
# the API on the host. Inside compose the API gets its own REDIS_URL.
REDIS_PASSWORD=redis_dev_pwd
REDIS_URL=redis://:redis_dev_pwd@localhost:6379/0
# REDIS_SOCKET_TIMEOUT_SECONDS=2

# Database
# Connect as a READ-ONLY role (see example/readonly_role.sql). Outside
# ENV=development the API refuses to start if this role is a superuser or
# can create roles/databases.
#   docker compose (API in container): ...@postgres:5432/ai_bi_db
#   API on host, compose Postgres:     ...@localhost:5433/ai_bi_db
DATABASE_URL=postgresql+psycopg2://ai_bi_readonly:readonly_pwd@localhost:5433/ai_bi_db
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# DB_CONNECT_TIMEOUT_SECONDS=5
# Pool per process. A request holds a connection only while its query runs.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# Threads serving requests per process (see docs/architecture.md).
# WORKER_THREADS=40

# Query scope: what the LLM is shown and may query.
# QUERYABLE_TABLES is required outside ENV=development (comma-separated;
# views allowed). REDACTED_COLUMNS takes table.column or a bare column
# name (hidden in every table). Mirror these with database grants; see
# example/readonly_role.sql.
QUERYABLE_SCHEMA=public
QUERYABLE_TABLES=products
REDACTED_COLUMNS=

# Result bounds: rows returned per query (the database stops at the cap),
# rows sampled into the explanation prompt, and the largest cached response.
MAX_RESULT_ROWS=1000
EXPLANATION_SAMPLE_ROWS=20
CACHE_MAX_BYTES=512000
# Response cache lifetime; 0 disables caching.
CACHE_TTL_SECONDS=300
# How long the introspected schema (tables, columns) is reused per process
# before it is read again; 0 reads it on every request.
SCHEMA_CACHE_TTL_SECONDS=300

# Longest accepted question (characters); it is sent to the LLM.
MAX_QUESTION_LENGTH=500

# LLM. Without OPENAI_API_KEY the API starts in development (queries fail
# with llm_unavailable) and refuses to start elsewhere.
LLM_PROVIDER=openai
OPENAI_API_KEY=your-key-here
# Model and output cap per task.
# LLM_SQL_MODEL=gpt-4o-mini
# LLM_SQL_MAX_TOKENS=1000
# LLM_EXPLAIN_MODEL=gpt-4o-mini
# LLM_EXPLAIN_MAX_TOKENS=400
# Per-attempt timeout and retries on transient errors (429, 5xx, network).
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
